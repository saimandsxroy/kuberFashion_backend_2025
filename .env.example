# ==============================================================================
# KuberFashion Backend — Environment Configuration Template (.env.example)
# Copy this file to .env and provide your actual values. NEVER commit .env to Git.
# ==============================================================================

# ===========================================
# SPRING PROFILE & SERVER CONFIGURATION
# ===========================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ===========================================
# POSTGRESQL + PGVECTOR DATABASE CONFIGURATION
# ===========================================
DATABASE_URL=jdbc:postgresql://localhost:5432/kuberfashion?sslmode=disable
DATABASE_USERNAME=kuberfashion_user
DATABASE_PASSWORD=your_secure_db_password_here
DATABASE_POOL_SIZE=10
DATABASE_MAX_LIFETIME=600000
DATABASE_CONNECTION_TIMEOUT=30000
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# ===========================================
# JWT SECURITY CONFIGURATION (REQUIRED)
# ===========================================
# Generate with: openssl rand -base64 32
# Must be at least 32 bytes (256-bit) Base64 string. No default fallback in production.
JWT_SECRET=your_base64_encoded_32_byte_secret_key_here
JWT_EXPIRATION=604800000

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://staging.kuberfashions.in,https://kuberfashions.in

# ===========================================
# REDIS CACHE CONFIGURATION
# ===========================================
# CACHE_TYPE options: 'redis' (production/staging) or 'simple' (in-memory fallback)
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# PHONEPE PAYMENT GATEWAY CONFIGURATION
# ===========================================
PHONEPE_CLIENT_ID=your_phonepe_merchant_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENVIRONMENT=SANDBOX
PHONEPE_REDIRECT_URL=https://staging.kuberfashions.in/payment/status
PHONEPE_WEBHOOK_USERNAME=your_webhook_auth_username
PHONEPE_WEBHOOK_PASSWORD=your_webhook_auth_password
# Simulation mode: MUST be false in production/staging
PHONEPE_SIMULATION_ENABLED=false

# ===========================================
# GEMINI AI & VECTOR EMBEDDING CONFIGURATION
# ===========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_TIMEOUT_SECONDS=15
GEMINI_FALLBACK_ENABLED=true
AI_SEARCH_VECTOR_ENABLED=true
AI_SEARCH_SIMILARITY_THRESHOLD=0.40

# ===========================================
# RECOMMENDATION ENGINE WEIGHTS (SUM = 100)
# ===========================================
REC_WEIGHT_CATEGORY=30
REC_WEIGHT_COLOR=15
REC_WEIGHT_VECTOR=35
REC_WEIGHT_POPULARITY=10
REC_WEIGHT_OFFER=10
REC_ORDER_HISTORY_DAYS=90
REC_RECENT_PURCHASE_DAYS=30
REC_MAX_GUEST_CART_IDS=20

# ===========================================
# CLOUDFLARE R2 STORAGE CONFIGURATION
# ===========================================
CLOUDFLARE_R2_ENABLED=false
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_BUCKET_NAME=kuberfashion-storage
CLOUDFLARE_R2_PUBLIC_URL=https://your-r2-public-url.com

# ===========================================
# LOGGING & ACTUATOR CONFIGURATION
# ===========================================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_KUBERFASHION=INFO
LOGGING_LEVEL_SECURITY=WARN
LOGGING_LEVEL_SQL=WARN
MANAGEMENT_ENDPOINTS_ENABLED=health,info
